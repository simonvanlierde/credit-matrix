{
  // Deploys via Cloudflare Workers Builds (Git integration) on push to `main`.
  // The following settings live in the Cloudflare dashboard, not here:
  // Build configuration:
  //   Build:   pnpm build
  //   Deploy:  pnpm exec wrangler deploy
  //   Root:    /
  // Branch control:
  //   Production branch: main
  //   Non-production builds: disabled
  //
  // Static assets only, no `main`: no code runs per request, so there is no
  // cold start and no CPU or memory limit to exceed. OpenNext's Worker used to
  // fail its cold start with error 1102 every hour or so.
  "$schema": "node_modules/wrangler/config-schema.json",
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page"
  },
  "compatibility_date": "2026-07-06",
  "name": "credit-heatmap",
  // Bound to a Custom Domain
  "routes": [
    {
      "pattern": "credit.duinlab.nl",
      "custom_domain": true
    }
  ],
  "workers_dev": false
}
