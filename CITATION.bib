  url = {https://github.com/simonvanlierde/credit-matrix},
  license = {MIT},
  abstract = {CRediT Matrix helps a research team draft the CRediT (Contributor Roles Taxonomy) contribution statement for a paper with its co-authors. Co-authors fill in their own rows through a shared link, can sign their reply with ORCID, and their replies are settled in one review. Contributors can be added from an ORCID iD, a DOI or a tenzing sheet, and an existing statement can be pasted in to fill the grid. The tool exports a contribution heatmap and the statement as JATS4R XML, a Crossref contributors block, CSV, a tenzing sheet, JSON, Markdown or input for the latex-credits LaTeX package, and linked CodeMeta people and roles for software attribution. Beside the grid it shows how often published papers in a field give each role, and a census page shows how 8.2 million open-access articles in Europe PMC use CRediT. The web app works offline in nine languages. The credit-matrix npm package adds a command-line tool, a credit-matrix web element, and integrations for Quarto, Pandoc, MyST, Sphinx, Jupyter Book 2 and Typst.},
  keywords = {CRediT, contributor roles taxonomy, authorship, contributorship, contribution statement, JATS4R, Crossref, tenzing, ORCID, scholarly publishing, open science, research software, Quarto, MyST, bibliometrics, Typst, CodeMeta, Pandoc, Sphinx, Jupyter Book, LaTeX},
}
