#. js-lingui-explicit-id
msgid "https://credit.niso.org/contributor-roles/conceptualization/name"
msgstr "Conceptualização"

#. js-lingui-explicit-id
msgid "https://credit.niso.org/contributor-roles/conceptualization/description"
msgstr "Ideias; formulação ou desenvolvimento geral de metas e objetivos."

#. js-lingui-explicit-id
msgid "https://credit.niso.org/contributor-roles/data-curation/name"
msgstr "Curadoria de dados"

#. js-lingui-explicit-id
msgid "https://credit.niso.org/contributor-roles/data-curation/description"
msgstr "Atividades de gestão para anotar (produzir metadados), depurar dados e manter dados de investigação (incluindo código de software, quando necessário para interpretar os dados) para utilização inicial e posterior reutilização."

#. js-lingui-explicit-id
msgid "https://credit.niso.org/contributor-roles/formal-analysis/name"
msgstr "Análise formal"

#. js-lingui-explicit-id
msgid "https://credit.niso.org/contributor-roles/formal-analysis/description"
msgstr "Aplicação de técnicas estatísticas, matemáticas, computacionais ou outras técnicas formais para analisar ou sintetizar os dados do estudo."

#. js-lingui-explicit-id
msgid "https://credit.niso.org/contributor-roles/funding-acquisition/name"
msgstr "Obtenção de financiamento"

#. js-lingui-explicit-id
msgid "https://credit.niso.org/contributor-roles/funding-acquisition/description"
msgstr "Obtenção de apoio financeiro para o projeto que deu origem a esta publicação."

#. js-lingui-explicit-id
msgid "https://credit.niso.org/contributor-roles/investigation/name"
msgstr "Investigação"

#. js-lingui-explicit-id
msgid "https://credit.niso.org/contributor-roles/investigation/description"
msgstr "Condução de um processo de investigação, especificamente a realização de experiências ou a recolha de dados ou provas."

#. js-lingui-explicit-id
msgid "https://credit.niso.org/contributor-roles/methodology/name"
msgstr "Metodologia"

#. js-lingui-explicit-id
msgid "https://credit.niso.org/contributor-roles/methodology/description"
msgstr "Desenvolvimento ou conceção da metodologia; criação de modelos."

#. js-lingui-explicit-id
msgid "https://credit.niso.org/contributor-roles/project-administration/name"
msgstr "Gestão do projeto"

#. js-lingui-explicit-id
msgid "https://credit.niso.org/contributor-roles/project-administration/description"
msgstr "Responsabilidade pela gestão e coordenação do planeamento e da execução da atividade de investigação."

#. js-lingui-explicit-id
msgid "https://credit.niso.org/contributor-roles/resources/name"
msgstr "Recursos"

#. js-lingui-explicit-id
msgid "https://credit.niso.org/contributor-roles/resources/description"
msgstr "Disponibilização de materiais de estudo, reagentes, materiais, pacientes, amostras de laboratório, animais, instrumentação, recursos computacionais ou outras ferramentas de análise."

#. js-lingui-explicit-id
msgid "https://credit.niso.org/contributor-roles/software/name"
msgstr "Software"

#. js-lingui-explicit-id
msgid "https://credit.niso.org/contributor-roles/software/description"
msgstr "Programação e desenvolvimento de software; conceção de programas informáticos; implementação de código e algoritmos de apoio; teste de componentes de código existentes."

#. js-lingui-explicit-id
msgid "https://credit.niso.org/contributor-roles/supervision/name"
msgstr "Supervisão"

#. js-lingui-explicit-id
msgid "https://credit.niso.org/contributor-roles/supervision/description"
msgstr "Responsabilidade de supervisão e liderança no planeamento e na execução da atividade de investigação, incluindo orientação externa à equipa principal."

#. js-lingui-explicit-id
msgid "https://credit.niso.org/contributor-roles/validation/name"
msgstr "Validação"

#. js-lingui-explicit-id
msgid "https://credit.niso.org/contributor-roles/validation/description"
msgstr "Verificação, no âmbito da atividade ou separadamente, da replicação ou reprodutibilidade global dos resultados, das experiências e de outros produtos da investigação."

#. js-lingui-explicit-id
msgid "https://credit.niso.org/contributor-roles/visualization/name"
msgstr "Visualização"

#. js-lingui-explicit-id
msgid "https://credit.niso.org/contributor-roles/visualization/description"
msgstr "Preparação, criação e/ou apresentação do trabalho publicado, especificamente a visualização ou apresentação dos dados."

#. js-lingui-explicit-id
msgid "https://credit.niso.org/contributor-roles/writing-original-draft/name"
msgstr "Redação – rascunho original"

#. js-lingui-explicit-id
msgid "https://credit.niso.org/contributor-roles/writing-original-draft/description"
msgstr "Preparação, criação e/ou apresentação do trabalho publicado, especificamente a redação do rascunho inicial (incluindo tradução substantiva)."

#. js-lingui-explicit-id
msgid "https://credit.niso.org/contributor-roles/writing-review-editing/name"
msgstr "Redação – revisão e edição"

#. js-lingui-explicit-id
msgid "https://credit.niso.org/contributor-roles/writing-review-editing/description"
msgstr "Preparação, criação e/ou apresentação do trabalho publicado pelos membros do grupo de investigação original, especificamente a revisão crítica ou o comentário, incluindo as fases anteriores ou posteriores à publicação."
