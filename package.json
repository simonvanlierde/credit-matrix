{
  "name": "credit-matrix-app",
  "version": "0.12.0",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@12.17.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "pnpm i18n:compile && node scripts/vendor-citesync.mjs && vite --host",
    "build": "pnpm i18n:compile && pnpm --filter credit-matrix build && node scripts/vendor-citesync.mjs && vite build && vite build --ssr src/entry-server.tsx --outDir .vite-ssr && node scripts/prerender.mjs && node scripts/postbuild.mjs",
    "start": "wrangler dev",
    "preview": "pnpm build && wrangler dev",
    "deploy": "pnpm build && wrangler deploy",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "pnpm i18n:compile && tsc --noEmit && tsc -p src/core/tsconfig.cli.json",
    "verify": "pnpm --filter credit-matrix build && pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm check:integrations && pnpm test:integrations",
    "test": "pnpm i18n:compile && vitest run",
    "test:coverage": "pnpm i18n:compile && vitest run --coverage",
    "check:integrations": "uv run --frozen --project integrations ruff check integrations/sphinx integrations/tests && uv run --frozen --project integrations ruff format --check integrations/sphinx integrations/tests && uv run --frozen --project integrations ty check integrations/sphinx integrations/tests",
    "test:integrations": "pnpm --filter credit-matrix build && uv run --frozen --project integrations pytest integrations/tests",
    "test:e2e": "playwright test",
    "validate:jats": "bash scripts/validate-jats.sh",
    "validate:crossref": "bash scripts/validate-crossref.sh",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "clean": "rm -rf out .vite-ssr",
    "version": "bash scripts/sync-citation.sh",
    "prepare": "lefthook install || true",
    "mutation": "stryker run && node scripts/mutation-baseline.mjs",
    "bench": "pnpm i18n:compile && vitest bench --run --config vitest.bench.config.mts",
    "i18n:compile": "node scripts/compile-catalogs.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@lingui/core": "^6.12.0",
    "@lingui/react": "^6.12.0",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-switch": "^1.3.7",
    "clsx": "^2.1.1",
    "immer": "^11.1.18",
    "lucide-react": "^1.49.0",
    "next-themes": "^0.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "^2.6.2",
    "@codspeed/vitest-plugin": "6.1.0",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@lingui/cli": "6.12.0",
    "@lingui/format-po": "6.12.0",
    "@playwright/test": "1.64.1",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.2.0",
    "@vitest/coverage-v8": "^5.0.3",
    "credit-matrix": "workspace:*",
    "fast-check": "4.10.2",
    "jsdom": "^30.1.1",
    "jupyter-book": "^2.1.7",
    "lefthook": "^2.1.16",
    "marked": "18.1.2",
    "mystmd": "^1.12.0",
    "pyodide": "314.0.7",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "8.3.5",
    "vitest": "^5.0.3",
    "wrangler": "^4.149.0",
    "xslt3": "2.7.0",
    "yaml": "2.9.1"
  }
}
