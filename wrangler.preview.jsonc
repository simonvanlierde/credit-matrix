// PR previews only: CI's preview job deploys each pull request's build as its own Worker,
// credit-matrix-pr-<number> (the name is passed with --name), and preview-retire.yml deletes
// that Worker when the pull request closes or turns draft. Production is wrangler.jsonc.
// See docs/deploy.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "credit-matrix-preview",
  "compatibility_date": "2026-07-06",
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page"
  },
  // Off: a version URL cannot be switched off apart from the Worker's own address, so a
  // preview has one address only, and it goes away when the Worker is deleted.
  "preview_urls": false,
  "workers_dev": true
}
