msgid "https://credit.niso.org/contributor-roles/conceptualization/name"
msgstr "Konzeptualisierung"

msgid "https://credit.niso.org/contributor-roles/conceptualization/description"
msgstr "Ideen; Formulierung oder Entwicklung der übergeordneten Forschungsziele."

msgid "https://credit.niso.org/contributor-roles/data-curation/name"
msgstr "Datenpflege"

msgid "https://credit.niso.org/contributor-roles/data-curation/description"
msgstr "Tätigkeiten zur Dokumentation (Erstellung von Metadaten), Bereinigung und Pflege von Forschungsdaten (einschließlich Softwarecode, sofern dieser für die Interpretation der Daten selbst erforderlich ist) für die Erstnutzung und spätere Wiederverwendung."

msgid "https://credit.niso.org/contributor-roles/formal-analysis/name"
msgstr "Formale Analyse"

msgid "https://credit.niso.org/contributor-roles/formal-analysis/description"
msgstr "Anwendung statistischer, mathematischer, computergestützter oder anderer formalisierter Techniken zur Analyse oder Synthese von Studiendaten."

msgid "https://credit.niso.org/contributor-roles/funding-acquisition/name"
msgstr "Akquise von Finanzmitteln"

msgid "https://credit.niso.org/contributor-roles/funding-acquisition/description"
msgstr "Beschaffung der finanziellen Unterstützung für das Projekt, das zu dieser Veröffentlichung führt."

msgid "https://credit.niso.org/contributor-roles/investigation/name"
msgstr "Untersuchung"

msgid "https://credit.niso.org/contributor-roles/investigation/description"
msgstr "Durchführung eines Forschungs- und Untersuchungsprozesses, insbesondere die Durchführung von Experimenten oder die Sammlung von Daten/Belegen."

msgid "https://credit.niso.org/contributor-roles/methodology/name"
msgstr "Methodik"

msgid "https://credit.niso.org/contributor-roles/methodology/description"
msgstr "Entwicklung oder Design der Methodik; Erstellung von Modellen."

msgid "https://credit.niso.org/contributor-roles/project-administration/name"
msgstr "Projektverwaltung"

msgid "https://credit.niso.org/contributor-roles/project-administration/description"
msgstr "Management- und Koordinationsverantwortung für die Planung und Durchführung der Forschungsaktivitäten."

msgid "https://credit.niso.org/contributor-roles/resources/name"
msgstr "Ressourcen"

msgid "https://credit.niso.org/contributor-roles/resources/description"
msgstr "Bereitstellung von Studienmaterial, Reagenzien, Materialien, Teilnehmer, Laborproben, Tieren, Instrumenten, Computerressourcen oder anderen Analysewerkzeugen."

msgid "https://credit.niso.org/contributor-roles/software/name"
msgstr "Software"

msgid "https://credit.niso.org/contributor-roles/software/description"
msgstr "Programmierung, Softwareentwicklung; Entwicklung von Computerprogrammen; Implementierung des Computercodes und unterstützender Algorithmen; Testen bestehender Codekomponenten."

msgid "https://credit.niso.org/contributor-roles/supervision/name"
msgstr "Supervision"

msgid "https://credit.niso.org/contributor-roles/supervision/description"
msgstr "Aufsichts- und Führungsverantwortung für die Planung und Durchführung der Forschungstätigkeit, einschließlich der Betreuung von außerhalb des Kernteams."

msgid "https://credit.niso.org/contributor-roles/validation/name"
msgstr "Validierung"

msgid "https://credit.niso.org/contributor-roles/validation/description"
msgstr "Überprüfung der allgemeinen Replikation/Reproduzierbarkeit von Ergebnissen/Experimenten und anderen Forschungsleistungen, entweder als Teil der Tätigkeit oder eigenständig."

msgid "https://credit.niso.org/contributor-roles/visualization/name"
msgstr "Visualisierung"

msgid "https://credit.niso.org/contributor-roles/visualization/description"
msgstr "Vorbereitung, Erstellung und/oder Präsentation der veröffentlichten Arbeit, insbesondere Visualisierung/Datenpräsentation."

msgid "https://credit.niso.org/contributor-roles/writing-original-draft/name"
msgstr "Schreiben – Originalentwurf"

msgid "https://credit.niso.org/contributor-roles/writing-original-draft/description"
msgstr "Vorbereitung, Erstellung und/oder Präsentation der veröffentlichten Arbeit, insbesondere das Schreiben des ersten Entwurfs (einschließlich wesentlicher Übersetzung)."

msgid "https://credit.niso.org/contributor-roles/writing-review-editing/name"
msgstr "Schreiben - Überprüfung und Überarbeitung"

msgid "https://credit.niso.org/contributor-roles/writing-review-editing/description"
msgstr "Vorbereitung, Erstellung und/oder Präsentation der veröffentlichten Arbeit durch die Mitglieder der ursprünglichen Forschungsgruppe, insbesondere kritische Überprüfung, Kommentierung oder Überarbeitung - einschließlich der Phasen vor oder nach der Veröffentlichung."
