{
  "name": "credit-matrix",
  "version": "0.11.0",
  "description": "CRediT (Contributor Roles Taxonomy) statements and exports: JATS4R XML, Crossref XML, linked CodeMeta attribution, CSV, JSON, Markdown and a heatmap SVG, with a CLI and a <credit-matrix> element.",
  "keywords": [
    "CRediT",
    "contributor roles taxonomy",
    "authorship",
    "JATS4R",
    "scholarly publishing",
    "CodeMeta"
  ],
  "license": "MIT",
  "author": "Simon van Lierde",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/simonvanlierde/credit-matrix.git",
    "directory": "src/core"
  },
  "homepage": "https://github.com/simonvanlierde/credit-matrix/tree/main/src/core#readme",
  "bugs": "https://github.com/simonvanlierde/credit-matrix/issues",
  "type": "module",
  "files": [
    "dist",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./lookup": "./dist/lookup.js",
    "./i18n": "./dist/i18n.js",
    "./figures": "./dist/figures.js",
    "./element": "./dist/element.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "credit-matrix": "./dist/cli.js"
  },
  "sideEffects": [
    "./dist/element.js",
    "./dist/cli.js"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "pnpm --dir ../.. i18n:compile && rm -rf dist && tsdown && mkdir -p dist/figure-fonts && cp figure-fonts/*.ttf figure-fonts/*.txt figure-fonts/README.md dist/figure-fonts/ && cp ../../LICENSE LICENSE",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@lingui/core": "^6.12.0",
    "@pdf-lib/fontkit": "1.1.1",
    "pdf-lib": "1.17.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "linkedom": "0.18.15",
    "rolldown": "1.2.16",
    "tsdown": "0.23.0",
    "yaml": "2.9.1"
  }
}
