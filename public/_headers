# Headers for statically served assets. The worker's responses get these from
# next.config.ts headers(); the ASSETS binding serves /sw.js, icons, and
# /_next/static/* before the worker runs, so they need their own copy.
/*
  X-Content-Type-Options: nosniff
  Strict-Transport-Security: max-age=31536000
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), geolocation=(), microphone=()
  X-Frame-Options: DENY

# The worker script itself: it fetches same-origin only.
/sw.js
  Content-Security-Policy: default-src 'self'
