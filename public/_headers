# Response headers for the whole site. Cloudflare applies these to every static
# asset; there is no Worker code, so this file is the only place they are set.
#
# CSP: a directive does not inherit from `default-src` when absent, it is
# simply unrestricted, so `default-src 'self'` is the base.
# - script-src: allows inline script here, but scripts/postbuild.mjs gives
#   every exported page a <meta> CSP whose script-src lists the hashes of that
#   page's own inline scripts (Next's bootstrap). The browser enforces both
#   policies, so only those scripts run. The hashes stay out of this file
#   because Cloudflare refuses a line over 2000 characters, and postbuild
#   fails the build if one is.
# - img-src needs blob:/data: for the heatmap PNG (canvas -> createObjectURL).
# - connect-src names the lookup APIs the browser calls directly
#   (ORCID, Crossref, and DataCite for DOIs Crossref does not hold), and
#   orcid.org for the keys that check a co-author's ORCID sign-in.
# `next dev` does not read this file, so the dev server runs without a CSP.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https://pub.orcid.org https://orcid.org https://api.crossref.org https://api.datacite.org; form-action 'none'; base-uri 'self'; frame-ancestors 'none'; object-src 'none'
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Permissions-Policy: camera=(), geolocation=(), microphone=()
  Referrer-Policy: no-referrer
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY

# Content-hashed: a changed file gets a new URL, so the browser never needs to revalidate.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Vendored fonts (src/app/fonts.css). Not hashed, so changing one means a new
# file name, never new bytes under the old one.
/fonts/*.woff2
  Cache-Control: public, max-age=31536000, immutable
