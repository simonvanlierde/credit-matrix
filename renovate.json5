// Follows project-templates' Renovate config. Minor and patch updates and the weekly relock
// merge themselves once the week's wait is over and every check on the branch has passed.
// Majors and the actions group stay for a person to merge.
{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  // config:recommended, not config:best-practices: its :pinDevDependencies opens pin PRs that
  // the lockfile already makes redundant, and a pin to a week-old version rarely clears the
  // wait below before a newer one comes out. Its two presets worth having are added by name: a
  // PR when this config uses a deprecated option, and a dashboard note on abandoned packages.
  extends: ["config:recommended", ":semanticCommits", ":configMigration", "abandonments:recommended"],
  schedule: ["before 9am on monday"],

  // A week gives a hijacked release time to be yanked.
  minimumReleaseAge: "7 days",

  // Renovate merges the PR itself. GitHub's own auto-merge may not use the ruleset bypass,
  // and would then wait for an approval.
  platformAutomerge: false,

  // A lock refresh has no release date, so the week's wait would hold it back for good.
  // pnpm's 3-day minimumReleaseAge and census/'s uv exclude-newer keep fresh releases out instead.
  lockFileMaintenance: {
    enabled: true,
    schedule: ["on monday"],
    minimumReleaseAge: null,
    automerge: true,
  },

  packageRules: [
    // Minor and patch bumps from every manager in one PR (.node-version included), dev tooling
    // in another, so a risky bump is not buried in lint-tool churn. Both merge themselves.
    {
      matchUpdateTypes: ["minor", "patch"],
      groupName: "runtime",
      automerge: true,
    },
    {
      matchManagers: ["npm", "pep621"],
      matchDepTypes: ["dependency-groups", "devDependencies"],
      matchUpdateTypes: ["minor", "patch"],
      groupName: "dev tooling",
    },
    // Actions updates wait for a person: the release and deploy steps that use them run only
    // after the merge. After the runtime rule, so it wins for actions.
    { matchManagers: ["github-actions"], groupName: "actions", automerge: false },
    // tsdown 0.23.1 and later build declarations with TypeScript's classic API, which TypeScript 7
    // no longer has. The way out is isolatedDeclarations, which needs explicit types on the zod schemas.
    {
      matchPackageNames: ["tsdown"],
      allowedVersions: "<=0.23.0",
    },
    // Core and the Vitest runner must move together.
    {
      matchPackageNames: ["/^@stryker-mutator\\//"],
      groupName: "stryker",
      automerge: false,
    },
  ],
}
