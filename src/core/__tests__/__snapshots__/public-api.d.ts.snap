//#region credit-roles.d.ts
/**
 * The 14 CRediT (Contributor Roles Taxonomy) roles as defined by NISO.
 * https://credit.niso.org/
 *
 * Stored as a const tuple so the role names are narrowed to their literal
 * string types, so callers can use `CreditRoleName` as a union type.
 *
 * Each role carries its canonical NISO `id` (the official role UUID) so the
 * identifiers travel with exported data. Crossref adds CRediT to its metadata
 * schema in 2026 and these UUIDs are the machine-readable role keys.
 */
export declare const CREDIT_ROLES: readonly [{
  readonly name: "Conceptualization";
  readonly id: "8b73531f-db56-4914-9502-4cc4d4d8ed73";
  readonly description: "Ideas; formulation or evolution of overarching research goals and aims.";
  readonly url: "https://credit.niso.org/contributor-roles/conceptualization/";
}, {
  readonly name: "Data curation";
  readonly id: "f93e0f44-f2a4-4ea1-824a-4e0853b05c9d";
  readonly description: "Management activities to annotate (produce metadata), scrub data and maintain research data (including software code, where it is necessary for interpreting the data itself) for initial use and later re-use.";
  readonly url: "https://credit.niso.org/contributor-roles/data-curation/";
}, {
  readonly name: "Formal analysis";
  readonly id: "95394cbd-4dc8-4735-b589-7e5f9e622b3f";
  readonly description: "Application of statistical, mathematical, computational, or other formal techniques to analyze or synthesize study data.";
  readonly url: "https://credit.niso.org/contributor-roles/formal-analysis/";
}, {
  readonly name: "Funding acquisition";
  readonly id: "34ff6d68-132f-4438-a1f4-fba61ccf364a";
  readonly description: "Acquisition of the financial support for the project leading to this publication.";
  readonly url: "https://credit.niso.org/contributor-roles/funding-acquisition/";
}, {
  readonly name: "Investigation";
  readonly id: "2451924d-425e-4778-9f4c-36c848ca70c2";
  readonly description: "Conducting a research and investigation process, specifically performing the experiments, or data/evidence collection.";
  readonly url: "https://credit.niso.org/contributor-roles/investigation/";
}, {
  readonly name: "Methodology";
  readonly id: "f21e2be9-4e38-4ab7-8691-d6f72d5d5843";
  readonly description: "Development or design of methodology; creation of models.";
  readonly url: "https://credit.niso.org/contributor-roles/methodology/";
}, {
  readonly name: "Project administration";
  readonly id: "a693fe76-ea33-49ad-9dcc-5e4f3ac5f938";
  readonly description: "Management and coordination responsibility for the research activity planning and execution.";
  readonly url: "https://credit.niso.org/contributor-roles/project-administration/";
}, {
  readonly name: "Resources";
  readonly id: "ebd781f0-bf79-492c-ac21-b31b9c3c990c";
  readonly description: "Provision of study materials, reagents, materials, patients, laboratory samples, animals, instrumentation, computing resources, or other analysis tools.";
  readonly url: "https://credit.niso.org/contributor-roles/resources/";
}, {
  readonly name: "Software";
  readonly id: "f89c5233-01b0-4778-93e9-cc7d107aa2c8";
  readonly description: "Programming, software development; designing computer programs; implementation of the computer code and supporting algorithms; testing of existing code components.";
  readonly url: "https://credit.niso.org/contributor-roles/software/";
}, {
  readonly name: "Supervision";
  readonly id: "0c8ca7d4-06ad-4527-9cea-a8801fcb8746";
  readonly description: "Oversight and leadership responsibility for the research activity planning and execution, including mentorship external to the core team.";
  readonly url: "https://credit.niso.org/contributor-roles/supervision/";
}, {
  readonly name: "Validation";
  readonly id: "4b1bf348-faf2-4fc4-bd66-4cd3a84b9d44";
  readonly description: "Verification, whether as a part of the activity or separate, of the overall replication/reproducibility of results/experiments and other research outputs.";
  readonly url: "https://credit.niso.org/contributor-roles/validation/";
}, {
  readonly name: "Visualization";
  readonly id: "76b9d56a-e430-4e0a-84c9-59c11be343ae";
  readonly description: "Preparation, creation and/or presentation of the published work, specifically visualization/data presentation.";
  readonly url: "https://credit.niso.org/contributor-roles/visualization/";
}, {
  readonly name: "Writing – original draft";
  readonly id: "43ebbd94-98b4-42f1-866b-c930cef228ca";
  readonly description: "Preparation, creation and/or presentation of the published work, specifically writing the initial draft (including substantive translation).";
  readonly url: "https://credit.niso.org/contributor-roles/writing-original-draft/";
}, {
  readonly name: "Writing – review & editing";
  readonly id: "d3aead86-f2a2-47f7-bb99-79de6421164d";
  readonly description: "Preparation, creation and/or presentation of the published work by those from the original research group, specifically critical review, commentary or revision – including pre- or post-publication stages.";
  readonly url: "https://credit.niso.org/contributor-roles/writing-review-editing/";
}];
