msgid "https://credit.niso.org/contributor-roles/conceptualization/name"
msgstr "Ideazione"

msgid "https://credit.niso.org/contributor-roles/conceptualization/description"
msgstr "Idee; formulazione o evoluzione di obiettivi e scopi generali della ricerca"

msgid "https://credit.niso.org/contributor-roles/data-curation/name"
msgstr "Cura dei dati"

msgid "https://credit.niso.org/contributor-roles/data-curation/description"
msgstr "Attività di gestione per annotare (produrre metadati), organizzare, pulire, e manutenzione dati (incluso il codice software, dove è necessario per l'interpretazione dei dati stessi) per un uso iniziale e un successivo riutilizzo."

msgid "https://credit.niso.org/contributor-roles/formal-analysis/name"
msgstr "Analisi formale"

msgid "https://credit.niso.org/contributor-roles/formal-analysis/description"
msgstr "Applicazione di tecniche statistiche, matematiche, computazionali o di altro tipo formale per analizzare o sintetizzare i dati degli studi"

msgid "https://credit.niso.org/contributor-roles/funding-acquisition/name"
msgstr "Acquisizione di fondi"

msgid "https://credit.niso.org/contributor-roles/funding-acquisition/description"
msgstr "Acquisizione del supporto finanziario per il progetto che ha portato a questa pubblicazione"

msgid "https://credit.niso.org/contributor-roles/investigation/name"
msgstr "Indagine"

msgid "https://credit.niso.org/contributor-roles/investigation/description"
msgstr "Conduzione di una ricerca e indagine, in particolare eseguire gli esperimenti o la raccolta di dati/evidenze."

msgid "https://credit.niso.org/contributor-roles/methodology/name"
msgstr "Metodologia"

msgid "https://credit.niso.org/contributor-roles/methodology/description"
msgstr "Sviluppo o ideazione di una metodologia; creazione di metodi."

msgid "https://credit.niso.org/contributor-roles/project-administration/name"
msgstr "Amministrazione di progetto"

msgid "https://credit.niso.org/contributor-roles/project-administration/description"
msgstr "Responsabilità di gestione e coordinamento della pianificazione e dell'esecuzione delle attività di ricerca"

msgid "https://credit.niso.org/contributor-roles/resources/name"
msgstr "Risorse"

msgid "https://credit.niso.org/contributor-roles/resources/description"
msgstr "Fornitura del materiale di studio, reagenti, materiali, pazienti, campioni di laboratorio, animali, strumentazione, risorse informatiche o altri strumenti di analisi."

msgid "https://credit.niso.org/contributor-roles/software/name"
msgstr "Programma"

msgid "https://credit.niso.org/contributor-roles/software/description"
msgstr "Programmazione, sviluppo software; progettazione di programmi informatici; implementazione del codice informatico e algoritmi di supporto; test dei componenti di codice esistenti."

msgid "https://credit.niso.org/contributor-roles/supervision/name"
msgstr "Supervisore"

msgid "https://credit.niso.org/contributor-roles/supervision/description"
msgstr "Responsabilità di supervisione e dirigenza per la pianificazione e l'esecuzione delle attività di ricerca, incluso il tutoraggio esterno al team principale."

msgid "https://credit.niso.org/contributor-roles/validation/name"
msgstr "Validazione"

msgid "https://credit.niso.org/contributor-roles/validation/description"
msgstr "Verifica della replicabilità/riproducibilità complessiva dei risultati/esempi e di altri output di ricerca, sia come parte dell'attività sia esternamente"

msgid "https://credit.niso.org/contributor-roles/visualization/name"
msgstr "Visualizzazione"

msgid "https://credit.niso.org/contributor-roles/visualization/description"
msgstr "Preparazione, creazione e/o presentazione del lavoro pubblicato, in particolare visualizzazione/presentazione dei dati."

msgid "https://credit.niso.org/contributor-roles/writing-original-draft/name"
msgstr "Redazione - bozza originale"

msgid "https://credit.niso.org/contributor-roles/writing-original-draft/description"
msgstr "reparazione, creazione e/o presentazione del lavoro pubblicato, in particolare la scrittura della bozza iniziale (inclusa la traduzione effettiva)."

msgid "https://credit.niso.org/contributor-roles/writing-review-editing/name"
msgstr "Scrittura - revisione e modifica"

msgid "https://credit.niso.org/contributor-roles/writing-review-editing/description"
msgstr "Preparazione, creazione e/o presentazione del lavoro pubblicato da parte di coloro che appartengono al gruppo di ricerca originale, in particolare revisione, nota critica o recensione– comprese le fasi di pre- o post-pubblicazione."
