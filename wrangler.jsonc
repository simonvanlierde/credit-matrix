{
  // Deployed from GitHub Actions (.github/workflows/ci.yml) after CI passes on
  // `main`. See docs/deploy.md.
  //
  // Static assets only, no `main`: no code runs per request, so there is no
  // cold start and no CPU or memory limit to exceed. OpenNext's Worker used to
  // fail its cold start with error 1102 every hour or so.
  "$schema": "node_modules/wrangler/config-schema.json",
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page"
  },
  "compatibility_date": "2026-07-06",
  // To rename, rename the Worker in the Cloudflare dashboard first. The PR
  // preview job (`wrangler versions upload`) creates an empty Worker under any
  // name that does not exist yet, which then blocks the dashboard rename.
  "name": "credit-matrix",
  // Bound to a Custom Domain
  "routes": [
    {
      "pattern": "credit.duinlab.nl",
      "custom_domain": true
    }
  ],
  // Preview URLs (the PR preview job) need both, and they turn on the
  // credit-matrix.<account>.workers.dev address as well.
  "preview_urls": true,
  "workers_dev": true
}
